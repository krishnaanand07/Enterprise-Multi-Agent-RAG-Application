# Application Info
APP_NAME="Enterprise RAG Assistant"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development

# Security & JWT
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local run with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_assistant

# LLM Provider (Google Gemini API)
GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash


# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & RAG Settings
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./vector_db/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# CORS Configuration
# Preferred format (JSON array string):
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://127.0.0.1:5500","https://your-frontend-domain.vercel.app"]
# Alternative supported format (comma-separated string):
# ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://your-frontend-domain.vercel.app

